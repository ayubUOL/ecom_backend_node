# Copy this file to .env and adjust values before running docker compose.
# .env is read automatically by docker compose and by dotenv inside the
# backend container for local (non-Docker) runs.

# --- App ---
APP_PORT=4000
JWT_SECRET=change_this_secret_in_production

# --- Database (used by both the backend and the mysql service) ---
DB_NAME=abdulsTobacco
DB_USER=abduls_user
DB_PASSWORD=abduls_pass
DB_ROOT_PASSWORD=root_pass
DB_PORT=3306
